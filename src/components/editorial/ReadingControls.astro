---
import { resolveLocale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/utils";
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<!-- Reading Mode Floating Controls -->
<div
  id="reading-controls-pill"
  class="pointer-events-none fixed bottom-6 left-1/2 z-100 flex -translate-x-1/2 translate-y-10 scale-95 items-center gap-4 rounded-full border border-accent/20 bg-background/85 px-6 py-3 opacity-0 shadow-2xl backdrop-blur-md transition-all duration-300 hover:border-accent/40"
>
  <!-- Accent Halo / Glow behind the pill -->
  <div class="animate-reading-halo pointer-events-none absolute -inset-1.5 -z-10 rounded-full bg-accent/20 blur-md"></div>

  <!-- Font style toggle (Sans / Serif) -->
  <div class="flex items-center gap-1.5">
    <button
      id="reading-font-sans"
      class="cursor-pointer rounded-full bg-accent px-2.5 py-1 text-xs font-medium text-background transition-colors hover:bg-accent/80"
      title={locale === "zh-CN" ? "无衬线字体" : "Sans Serif Font"}
    >
      Sans
    </button>
    <button
      id="reading-font-serif"
      class="cursor-pointer rounded-full px-2.5 py-1 text-xs font-medium text-foreground/60 transition-colors hover:bg-foreground/5 hover:text-foreground"
      title={locale === "zh-CN" ? "衬线字体" : "Serif Font"}
    >
      Serif
    </button>
  </div>

  <div class="h-4 w-px bg-border/40"></div>

  <!-- Font size controls -->
  <div class="flex items-center gap-2">
    <button
      id="reading-size-dec"
      class="cursor-pointer rounded-full p-1 text-foreground/60 transition-colors hover:bg-foreground/5 hover:text-foreground"
      title={locale === "zh-CN" ? "缩小字号" : "Decrease Font Size"}
      aria-label={locale === "zh-CN" ? "缩小字号" : "Decrease Font Size"}
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>

    <span
      id="reading-size-display"
      class="min-w-[3ch] text-center font-mono text-xs font-medium"
    >
      100%
    </span>

    <button
      id="reading-size-inc"
      class="cursor-pointer rounded-full p-1 text-foreground/60 transition-colors hover:bg-foreground/5 hover:text-foreground"
      title={locale === "zh-CN" ? "放大字号" : "Increase Font Size"}
      aria-label={locale === "zh-CN" ? "放大字号" : "Increase Font Size"}
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
  </div>

  <div class="h-4 w-px bg-border/40"></div>

  <!-- Exit reading mode button -->
  <button
    id="reading-exit-btn"
    class="flex cursor-pointer items-center gap-1.5 rounded-full bg-foreground/10 px-3 py-1 text-xs font-semibold text-foreground transition-colors hover:bg-foreground/15"
    title={
      locale === "zh-CN"
        ? "退出阅读模式（快捷键 R）"
        : "Exit Reading Mode (Shortcut: r)"
    }
  >
    <span>{t("post.exit")}</span>
    <kbd class="hidden rounded border border-foreground/20 bg-foreground/5 px-1.5 py-0.5 text-[9px] opacity-60 sm:inline-block">
      R
    </kbd>
  </button>
</div>
