---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { resolveLocale } from "@/i18n/locales";

interface Props {
  slug: "about" | "now";
}
const { slug } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const entry = await getEntry("pages", `${locale.toLowerCase()}/${slug}`);
if (!entry) throw new Error(`Missing editorial page: ${locale}/${slug}`);
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <Header />
  <main id="main-content" class="app-layout py-12">
    <h1 class="mb-6 text-4xl font-bold">{entry.data.title}</h1>
    <article class="prose max-w-prose">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>
