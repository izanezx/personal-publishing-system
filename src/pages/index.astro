---
import { localizedPath, localePrefix, resolveLocale } from "@/i18n/locales";
import {
  adaptPublication,
  getEntryActivityMs,
  getPublicationFeed,
  getPublicEntries,
} from "@/lib/content/queries";
import Layout from "@/layouts/Layout.astro";
import Bento from "@/components/editorial/Bento.astro";
import Timeline from "@/components/editorial/Timeline.astro";
import GalleryShelf from "@/components/editorial/GalleryShelf.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import IntroAudio from "@/components/IntroAudio.astro";
import { useTranslations } from "@/i18n/utils";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = localePrefix(locale);

const sortedPosts = await getPublicationFeed(locale);
const featuredPosts = sortedPosts.filter(
  ({ data }) => "featured" in data && data.featured
);
const recentPosts = sortedPosts.filter(
  ({ data }) => !("featured" in data && data.featured)
);
const en = locale === "en";
const sections = [
  [
    "garden",
    "知识花园",
    "Garden",
    "按主题和成熟度浏览内容。",
    "Explore subjects and follow how ideas develop.",
  ],
  [
    "research",
    "研究",
    "Research",
    "实验与研究记录。",
    "Experiments and research notes.",
  ],
  [
    "notes",
    "笔记",
    "Notes",
    "短篇记录与观察。",
    "Short notes and observations.",
  ],
  [
    "projects",
    "项目",
    "Projects",
    "正在构建的项目。",
    "Work in progress and completed projects.",
  ],
  [
    "library",
    "资料库",
    "Library",
    "阅读材料和参考资料。",
    "Reading material and references.",
  ],
  [
    "now",
    "近况",
    "Now",
    "查看最近在推进的工作。",
    "See what's being worked on now.",
  ],
].map(([path, zh, english, description, englishDescription]) => ({
  href: localizedPath(locale, `/${path}`),
  title: en ? english : zh,
  description: en ? englishDescription : description,
}));
const activity = (await getPublicationFeed(locale, "activity"))
  .slice(0, 5)
  .map(item => {
    const { path, title } = adaptPublication(item);
    return { path, title, date: new Date(getEntryActivityMs(item)) };
  });
const galleries = (await getPublicEntries("galleries", locale)).slice(0, 3);
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="relative app-layout">
    <!-- ═══════════════════ HERO ═══════════════════ -->
    <section
      id="hero"
      class="hero-section relative pt-10 pb-14 sm:pt-14 sm:pb-20"
    >
      <div class="relative z-10">
        <!-- Terminal prompt badge -->
        <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-border/40 bg-muted/20 px-3.5 py-1.5 font-firacode text-xs sm:text-sm">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <span class="text-accent">{SITE.heroTerminalPrompt.prefix}</span>
          {SITE.heroTerminalPrompt.path}
          <span class="opacity-40">{SITE.heroTerminalPrompt.suffix}</span>
        </div>

        <!-- Title -->
        <h1 class="hero-title mb-3 text-5xl leading-[1.1] font-bold tracking-tight sm:text-6xl lg:text-7xl">
          {SITE.title}
          <a
            target="_blank"
            href={`${prefix}/rss.xml`}
            class="ml-1 inline-block align-middle"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={22}
              height={22}
              class="stroke-accent stroke-3 opacity-40 transition-opacity duration-300 hover:opacity-100"
            />
          </a>
        </h1>

        {SITE.introAudio.enabled && (
          <div class="mt-3">
            <IntroAudio
              src={SITE.introAudio.src}
              label={SITE.introAudio.label}
              duration={SITE.introAudio.duration}
              isStream={SITE.introAudio.isStream}
            />
          </div>
        )}

        {SITE.desc && (
          <p class="mt-7 max-w-xl text-base leading-relaxed opacity-75 sm:text-lg">
            {SITE.desc}
          </p>
        )}
        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4">
          {SITE.author && <p class="text-sm opacity-50">{SITE.author}</p>}
          {
            // only display if at least one social link is enabled
            SOCIALS.length > 0 && (
              <div class="sm:border-l border-border/40 sm:pl-4">
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- ═══════════════════ FEATURED ═══════════════════ -->
    {featuredPosts.length > 0 && (
      <section id="featured" class="pb-6">
        <div class="mb-6 flex items-center gap-3">
          <h2 class="flex items-center gap-2 text-sm font-bold tracking-widest text-accent uppercase">
            <svg
              class="size-4"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            {t("index.featured")}
          </h2>
          <div class="h-px flex-1 bg-border/20" />
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 [&>li]:my-0">
          {featuredPosts.map((data, index) => (
            <Card
              variant="h3"
              featured={true}
              {...data}
              loading={index < 2 ? "eager" : "lazy"}
              fetchpriority={index < 2 ? "high" : "auto"}
            />
          ))}
        </ul>
      </section>
    )}

    <!-- ═══════════════════ RECENT POSTS ═══════════════════ -->
    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-6 pb-6">
        <div class="mb-6 flex items-center gap-3">
          <h2 class="text-sm font-bold tracking-widest uppercase">
            {t("index.recent")}
          </h2>
          <div class="h-px flex-1 bg-border/20" />
          <span class="font-firacode text-xs text-accent/80 select-none">
            [{recentPosts.slice(0, SITE.postPerIndex).length}/
            {recentPosts.length}]
          </span>
        </div>
        <ul
          class:list={[
            SITE.indexPostsGrid &&
              "grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3",
          ]}
        >
          {recentPosts.map(
            (data, index) =>
              index < SITE.postPerIndex && (
                <Card
                  variant="h3"
                  {...data}
                  loading={index < 2 ? "eager" : "lazy"}
                  fetchpriority={index < 2 ? "high" : "auto"}
                />
              )
          )}
        </ul>

        <!-- ═══════════════════ CTA ═══════════════════ -->
        <div class="mt-8 mb-4 flex justify-center w-full">
          <LinkButton
            href={`${prefix}/posts/`}
            class="group inline-flex items-center w-full sm:w-auto justify-center gap-2 rounded-xl border border-accent/20 bg-accent/10 px-8 py-4 text-base font-bold text-accent transition-all duration-300 hover:border-accent hover:bg-accent/20 hover:shadow-xl hover:shadow-accent/20 hover:-translate-y-0.5"
          >
            {t("index.exploreAll")}
            <IconArrowRight class="inline-block transition-transform duration-300 group-hover:translate-x-1 rtl:-rotate-180" />
          </LinkButton>
        </div>
      </section>
    )}
    <Bento
      title={en ? "Explore the publication" : "出版索引"}
      entries={sections}
    />
    <Timeline
      title={en ? "Recent activity" : "最近动态"}
      entries={activity}
      locale={locale}
      timezone={SITE.timezone}
    />
    <GalleryShelf
      title={en ? "Visual notes" : "视觉记录"}
      galleries={galleries}
      href={localizedPath(locale, "/galleries")}
      linkLabel={en ? "All galleries" : "全部图库"}
    />
  </main>
  <Footer />
</Layout>

<style>
  /* ── Hero title shimmer ── */
  .hero-title {
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 20%,
      var(--foreground) 35%,
      var(--foreground) 65%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 80%,
      var(--accent) 100%
    );
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }

    // ── Card glow follow cursor ──
    document.querySelectorAll<HTMLElement>(".card-glow").forEach(card => {
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
      });
    });
  });
</script>
