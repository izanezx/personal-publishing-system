# Optional public values. Leave empty to hide the corresponding UI.
PUBLIC_SOCIAL_GITHUB=
PUBLIC_SOCIAL_X=
PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_EMAIL=
PUBLIC_EDIT_POST_URL=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Build and deployment policy. Keep false until the owner approves public
# indexing. CI and Cloudflare workflows set this from repository variables.
PUBLIC_INDEXING_ENABLED=false

# Production uses the root. For an alternate mount, set SITE_BASE_PATH in the
# shell when running build and preview, for example /publishing.
