{
  "name": "personal-publishing-system",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node scripts/run-project-tool.mjs astro dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/run-project-tool.mjs astro preview",
    "sync": "node scripts/run-project-tool.mjs astro sync",
    "test": "node --import ./tests/ts-loader.mjs --test tests/*.test.ts",
    "astro": "node scripts/run-project-tool.mjs astro",
    "format:check": "node scripts/run-project-tool.mjs prettier --check .",
    "format": "node scripts/run-project-tool.mjs prettier --write .",
    "lint": "node scripts/run-project-tool.mjs eslint .",
    "cms:check": "node scripts/validate-cms-config.mjs",
    "security:audit": "pnpm audit --audit-level=high",
    "skills:check": "node scripts/check-skills.mjs",
    "skills:lock": "node scripts/check-skills.mjs --write",
    "test:e2e": "playwright test",
    "test:release": "node scripts/release-drill.mjs",
    "smoke": "node scripts/smoke.mjs",
    "status:due": "node scripts/status-due.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "rehype-callouts": "2.2.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-binding-wasm32-wasi": "0.5.3",
    "@pagefind/default-ui": "^1.6.0",
    "@playwright/test": "1.65.1",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.12.4",
    "@typescript-eslint/parser": "^8.74.0",
    "ajv": "8.20.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "fast-uri": "3.1.9",
      "fast-xml-parser": "5.12.1",
      "fflate": "0.7.5",
      "nanoid@3": "3.3.20",
      "postcss": "8.5.33",
      "postcss-selector-parser@6.0.10": "6.1.6",
      "postcss-selector-parser@^7.1.0": "7.2.1",
      "source-map-js": "1.2.4",
      "zod": "4.6.7"
    }
  },
  "private": true
}
